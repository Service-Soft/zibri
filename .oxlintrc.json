{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "options": { "typeAware": true },
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "jsdoc"],
    "jsPlugins": [
        { "name": "jsdoc-js", "specifier": "eslint-plugin-jsdoc" },
        { "name": "sonarjs", "specifier": "eslint-plugin-sonarjs" },
        { "name": "typescript-js", "specifier": "@typescript-eslint/eslint-plugin" },
        { "name": "unicorn-js", "specifier": "eslint-plugin-unicorn" },
        { "name": "import-js", "specifier": "eslint-plugin-import" }
    ],
    "ignorePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**",
        "**/__testing__/file-output/**",
        ".zibri/**",
        "packages/zibri/docs/**",
        "packages/zibri/src/di/default/temp/**",
        "packages/cli/assets/**",
        "packages/cli/sandbox/**",
        "packages/sandbox/**"
    ],
    "rules": {
        "curly": "warn",
        "no-loop-func": "warn",
        "no-loss-of-precision": "warn",
        "no-redeclare": "warn",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "no-unused-expressions": "warn",
        "no-unused-vars": "warn",
        "no-duplicate-imports": "warn",
        "prefer-const": "warn",
        "prefer-arrow-callback": "warn",
        "no-unused-labels": "warn",
        "no-array-constructor": "warn",
        "no-console": "warn",
        "no-const-assign": "warn",
        "jsdoc/check-access": "warn",
        "jsdoc-js/check-alignment": "warn",
        "jsdoc-js/check-indentation": "warn",
        "jsdoc-js/check-line-alignment": "warn",
        "jsdoc-js/check-param-names": "warn",
        "jsdoc/check-property-names": "warn",
        "jsdoc-js/check-syntax": "warn",
        "jsdoc/check-tag-names": "warn",
        "jsdoc-js/check-types": "warn",
        "jsdoc-js/check-values": "warn",
        "jsdoc/empty-tags": "warn",
        "jsdoc/implements-on-classes": "warn",
        "jsdoc-js/match-description": "warn",
        "jsdoc-js/multiline-blocks": "warn",
        "jsdoc-js/tag-lines": "warn",
        "jsdoc-js/no-bad-blocks": "warn",
        "jsdoc/no-defaults": "warn",
        "jsdoc-js/no-multi-asterisks": "warn",
        "jsdoc-js/no-types": "warn",
        "jsdoc-js/no-undefined-types": "warn",
        "jsdoc-js/require-asterisk-prefix": "warn",
        "jsdoc-js/require-description": ["warn", { "contexts": ["any"] }],
        "jsdoc-js/require-description-complete-sentence": "warn",
        "jsdoc-js/require-hyphen-before-param-description": "warn",
        "jsdoc-js/require-jsdoc": [
            "warn",
            {
                "contexts": [
                    "ExportNamedDeclaration",
                    "ClassDeclaration",
                    "TSPropertySignature",
                    "PropertyDefinition[accessibility!=\"private\"][override=false]",
                    "MethodDefinition[accessibility!=\"private\"][override=false][kind!=\"set\"][key.name!=\"constructor\"]",
                    "TSInterfaceDeclaration",
                    "TSEnumDeclaration",
                    "TSTypeAliasDeclaration",
                    "TSDeclareFunction"
                ]
            }
        ],
        "jsdoc/require-param": "warn",
        "jsdoc/require-param-description": "warn",
        "jsdoc/require-param-name": "warn",
        "jsdoc/require-property": "warn",
        "jsdoc/require-property-description": "warn",
        "jsdoc/require-property-name": "warn",
        "jsdoc/require-property-type": "warn",
        "jsdoc-js/require-returns": [
            "warn",
            {
                "contexts": [
                    "ClassProperty",
                    "MethodDefinition[value.returnType.typeAnnotation.type!=\"TSVoidKeyword\"]",
                    "FunctionDeclaration[returnType.typeAnnotation.type!=\"TSVoidKeyword\"]:not([returnType.typeAnnotation.typeName.name=\"MethodDecorator\"]):not([returnType.typeAnnotation.typeName.name=\"ClassDecorator\"]):not([returnType.typeAnnotation.typeName.name=\"PropertyDecorator\"]):not([returnType.typeAnnotation.typeName.name=\"ParameterDecorator\"])"
                ]
            }
        ],
        "jsdoc-js/require-returns-check": "warn",
        "jsdoc/require-returns-description": "warn",
        "jsdoc-js/require-throws": "warn",
        "jsdoc/require-yields": "warn",
        "jsdoc-js/require-yields-check": "warn",
        "jsdoc-js/valid-types": "warn"
    },
    "overrides": [
        {
            "files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
            "rules": {
                "no-implied-eval": "warn",
                "no-shadow": "warn",
                "no-throw-literal": "warn",
                "no-use-before-define": "warn",
                "jsdoc-js/require-description": "off"
            }
        },
        {
            "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
            "rules": {
                "typescript/no-deprecated": "warn",
                "typescript/explicit-function-return-type": ["warn", { "allowExpressions": true }],
                "typescript/no-explicit-any": "warn",
                "typescript/array-type": "warn",
                "typescript/explicit-member-accessibility": ["warn", { "accessibility": "no-public" }],
                "typescript/no-empty-interface": "warn",
                "typescript/class-literal-property-style": "warn",
                "typescript/consistent-type-assertions": "warn",
                "typescript-js/member-ordering": ["warn", { "default": ["field", "constructor", "method"] }],
                "typescript/method-signature-style": "warn",
                "typescript/no-base-to-string": "warn",
                "typescript/no-confusing-non-null-assertion": "warn",
                "typescript/no-confusing-void-expression": ["warn", { "ignoreArrowShorthand": true }],
                "no-dupe-class-members": "warn",
                "typescript/no-duplicate-enum-values": "warn",
                "typescript/no-dynamic-delete": "warn",
                "typescript/no-extra-non-null-assertion": "warn",
                "typescript/no-floating-promises": "warn",
                "typescript/no-for-in-array": "warn",
                "typescript/no-implied-eval": "warn",
                "typescript/no-misused-new": "warn",
                "typescript/no-misused-promises": "warn",
                "typescript/no-misused-spread": "off",
                "typescript/no-namespace": "warn",
                "typescript/no-non-null-asserted-nullish-coalescing": "warn",
                "typescript/no-non-null-asserted-optional-chain": "warn",
                "typescript/no-non-null-assertion": "warn",
                "typescript/no-require-imports": "warn",
                "typescript/no-this-alias": "warn",
                "typescript/only-throw-error": "warn",
                "typescript/no-unnecessary-boolean-literal-compare": "warn",
                "typescript/no-unnecessary-qualifier": "warn",
                "typescript/no-unnecessary-type-assertion": "warn",
                "typescript/no-unnecessary-type-constraint": "warn",
                "typescript/no-unsafe-argument": "warn",
                "typescript/no-unsafe-assignment": "warn",
                "typescript/no-unsafe-call": "warn",
                "typescript/no-unsafe-member-access": "warn",
                "typescript/no-unsafe-return": "warn",
                "no-use-before-define": ["warn", { "functions": false, "classes": false }],
                "typescript/no-useless-empty-export": "warn",
                "typescript/no-var-requires": "warn",
                "no-var": "warn",
                "typescript/prefer-enum-initializers": "warn",
                "typescript/prefer-for-of": "warn",
                "typescript/prefer-includes": "warn",
                "typescript/prefer-literal-enum-member": "warn",
                "typescript/prefer-nullish-coalescing": "warn",
                "typescript/prefer-optional-chain": "warn",
                "typescript/prefer-readonly": "warn",
                "typescript/prefer-reduce-type-parameter": "warn",
                "typescript/prefer-string-starts-ends-with": "warn",
                "typescript/promise-function-async": ["warn", { "checkArrowFunctions": false }],
                "typescript/require-await": "warn",
                "typescript/restrict-plus-operands": "warn",
                "typescript/strict-boolean-expressions": [
                    "warn",
                    {
                        "allowString": true,
                        "allowNumber": true,
                        "allowNullableObject": true,
                        "allowNullableBoolean": false,
                        "allowNullableString": true,
                        "allowNullableNumber": true
                    }
                ],
                "typescript/switch-exhaustiveness-check": "warn",
                "typescript-js/typedef": ["warn", { "arrowParameter": false, "variableDeclaration": true, "memberVariableDeclaration": true }],
                "import/first": "warn",
                "import/no-unassigned-import": "warn",
                "import/no-duplicates": "warn",
                "import/newline-after-import": "warn",
                "import/no-absolute-path": "warn",
                "import-js/no-useless-path-segments": "warn",
                "promise/no-multiple-resolved": "warn",
                "promise/no-nesting": "warn",
                "promise/no-new-statics": "warn",
                "promise/no-promise-in-callback": "warn",
                "promise/no-return-in-finally": "warn",
                "promise/no-return-wrap": "warn",
                "promise/param-names": "warn",
                "promise/prefer-await-to-callbacks": "warn",
                "promise/prefer-await-to-then": "warn",
                "promise/valid-params": "warn",
                "unicorn-js/better-regex": "warn",
                "unicorn/catch-error-name": "warn",
                "unicorn-js/consistent-destructuring": "warn",
                "unicorn/custom-error-definition": "warn",
                "unicorn/error-message": "warn",
                "unicorn/escape-case": "warn",
                "unicorn/filename-case": "warn",
                "unicorn/new-for-builtins": "warn",
                "unicorn/no-array-for-each": "warn",
                "unicorn/no-instanceof-array": "warn",
                "unicorn/no-lonely-if": "warn",
                "unicorn/no-new-buffer": "warn",
                "unicorn/no-null": "warn",
                "unicorn/no-single-promise-in-promise-methods": "warn",
                "unicorn/no-unnecessary-await": "warn",
                "unicorn-js/no-unused-properties": "warn",
                "unicorn/no-useless-spread": "warn",
                "unicorn/no-zero-fractions": "warn",
                "unicorn/prefer-date-now": "warn",
                "unicorn/prefer-default-parameters": "warn",
                "unicorn/prefer-number-properties": "warn",
                "unicorn/prefer-string-replace-all": "warn",
                "unicorn-js/prefer-switch": "warn",
                "unicorn/prefer-ternary": "warn",
                "unicorn/switch-case-braces": "warn",
                "unicorn/text-encoding-identifier-case": "warn",
                "unicorn/throw-new-error": "warn",
                "sonarjs/no-all-duplicated-branches": "warn",
                "sonarjs/no-empty-collection": "warn",
                "sonarjs/no-identical-conditions": "warn",
                "sonarjs/no-identical-expressions": "warn",
                "sonarjs/no-ignored-return": "warn",
                "sonarjs/non-existent-operator": "warn",
                "sonarjs/cognitive-complexity": "warn",
                "sonarjs/no-duplicate-string": "warn",
                "sonarjs/no-duplicated-branches": "warn",
                "sonarjs/no-identical-functions": "warn",
                "sonarjs/no-nested-switch": "warn",
                "sonarjs/no-nested-template-literals": "warn",
                "sonarjs/no-redundant-jump": "warn",
                "sonarjs/no-small-switch": "warn",
                "sonarjs/no-unused-collection": "warn",
                "sonarjs/no-useless-catch": "warn",
                "sonarjs/prefer-single-boolean-return": "warn",
                "sonarjs/prefer-while": "warn",
                "no-implied-eval": "off",
                "no-shadow": "off",
                "no-throw-literal": "off"
            }
        },
        {
            "files": [
                "**/*.controller.ts",
                "**/*.repository.ts",
                "**/*.migration.ts",
                "**/*.test.ts",
                "**/*.cases.ts",
                "packages/zibri/**/__testing__/**/*.ts"
            ],
            "rules": {
                "jsdoc-js/require-jsdoc": "off",
                "typescript/require-array-sort-compare": "off",
                "typescript/no-unsafe-assignment": "off"
            }
        },
        {
            "files": ["**/*.migration.ts", "**/*.test.ts"],
            "rules": {
                "sonarjs/no-duplicate-string": "off"
            }
        },
        {
            "files": ["**/*.model.ts"],
            "rules": {
                "typescript/no-empty-interface": "off"
            }
        }
    ]
}
