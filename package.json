        "cspell": "^10.4.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^62.7.0",
        "eslint-plugin-sonarjs": "^4.0.2",
        "eslint-plugin-unicorn": "^63.0.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
