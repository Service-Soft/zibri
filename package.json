{
    "name": "zibri",
    "version": "3.0.0",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "module": "./dist/esm/index.mjs",
    "repository": {
        "url": "https://github.com/Service-Soft/zibri"
    },
    "exports": {
        ".": {
            "types": "./dist/cjs/index.d.ts",
            "require": "./dist/cjs/index.js",
            "import": "./dist/esm/index.mjs"
        }
    },
    "files": [
        "./src",
        "./dist",
        "./README.md",
        "./CONTRIBUTING.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "jest",
        "test:ci": "jest --testPathPatterns='^(?!.*multithreading\\.service\\.test\\.ts$).*'",
        "sandbox": "cd sandbox && npm run start",
        "sandbox:build": "cd sandbox && npm run build",
        "start": "npm-run-all -p watch:cjs watch:esm",
        "watch:cjs": "tsc -p tsconfig.cjs.json --watch",
        "watch:esm": "tsc -p tsconfig.esm.json --watch",
        "build:prod": "npm run build && typedoc",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:post": "node post-build.mjs",
        "build": "npm run build:cjs && npm run build:esm && npm run build:post",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix"
    },
    "keywords": [
        "Zibri",
        "Backend",
        "Framework"
    ],
    "author": "Tim Fabian",
    "license": "MIT",
    "description": "TS Backend Framework",
    "peerDependencies": {
        "bcryptjs": "^3.0.3",
        "bignumber.js": "^11.1.1",
        "handlebars": "^4.7.9",
        "hi-base32": "^0.5.1",
        "jsonwebtoken": "^9.0.3",
        "otpauth": "^9.5.1",
        "pdfmake": "^0.2.23",
        "pg": "^8.21.0",
        "preact": "^10.29.2",
        "preact-render-to-string": "^6.7.0",
        "rxjs": "^7.8.2",
        "socket.io": "^4.8.3",
        "ts-node": "^10.9.2",
        "xmlbuilder2": "^4.0.3"
    },
    "peerDependenciesMeta": {
        "bcryptjs": {
            "optional": true
        }
    },
    "dependencies": {
        "@fastify/busboy": "^3.2.0",
        "express": "^5.2.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.0.1",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "swagger2openapi": "^7.0.8",
        "systeminformation": "^5.31.6",
        "typeorm": "^0.3.29"
    },
    "devDependencies": {
        "@faker-js/faker": "^9.9.0",
        "@jest/globals": "^30.4.1",
        "@swc/core": "^1.15.40",
        "@testcontainers/postgresql": "^12.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.9.1",
        "@types/nodemailer": "^8.0.0",
        "@types/pdfmake": "^0.2.11",
        "@types/swagger2openapi": "^7.0.4",
        "bcryptjs": "^3.0.3",
        "eslint": "^9.36.0",
        "eslint-config-service-soft": "^2.1.6",
        "form-data": "^4.0.6",
        "jest": "^30.4.2",
        "npm-run-all": "^4.1.5",
        "openapi3-ts": "^4.5.0",
        "socket.io-client": "^4.8.3",
        "testcontainers": "^12.0.0",
        "ts-jest": "^29.4.11",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.2"
    }
}