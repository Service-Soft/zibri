{
    "name": "zibri-cli",
    "version": "3.0.0",
    "license": "MIT",
    "main": "./dist/index.js",
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/cli"
    },
    "files": [
        "./dist",
        "./README.md",
        "./LICENSE",
        "./assets",
        "./templates"
    ],
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "zibri",
        "cli"
    ],
    "author": "Tim Fabian",
    "description": "",
    "bin": {
        "zi": "dist/index.js"
    },
    "scripts": {
        "start": "npm run build && cd sandbox && ZIBRI_CLI_LOCAL_DEV=1 node ../dist/index.js",
        "build": "tsc -p tsconfig.build.json",
        "clear": "rm -rf sandbox && mkdir sandbox && npm run start n api",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "prepublishOnly": "npm run build",
        "test": "npm run test:normal && npm run test:heavy",
        "test:normal": "jest --testPathPatterns='^(?!.*\\.heavy\\.test\\.ts$).*'",
        "test:heavy": "jest --runInBand --testPathPatterns='\\.heavy\\.test\\.ts$'"
    },
    "dependencies": {
        "chalk": "^5.4.1",
        "death": "^1.1.0",
        "figlet": "^1.8.1",
        "inquirer": "^13.3.2"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@types/death": "^1.1.5",
        "@types/figlet": "^1.7.0",
        "@types/node": "^22.19.17",
        "eslint": "^9.24.0",
        "eslint-config-service-soft": "^2.1.6",
        "jest": "^30.4.2",
        "jest-diff": "^30.4.1",
        "ts-jest": "^29.4.11",
        "typescript": "^5.8.3"
    }
}