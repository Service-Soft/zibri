{
    "name": "zibri-cli",
    "version": "3.0.0",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/cli"
    },
    "files": [
        "./dist",
        "./README.md",
        "./LICENSE",
        "./assets",
        "./templates"
    ],
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "zibri",
        "cli"
    ],
    "author": "Tim Fabian",
    "description": "Command line interface for the Zibri framework. Scaffolds a new project with `zi new`.",
    "bin": {
        "zi": "dist/index.js"
    },
    "scripts": {
        "start": "npm run build && cd sandbox && ZIBRI_CLI_LOCAL_DEV=1 node ../dist/index.js",
        "build": "npm run build:clean && tsc -p tsconfig.build.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "clear": "rm -rf sandbox && mkdir sandbox && npm run start n api",
        "lint": "oxlint -c ../../.oxlintrc.json --max-warnings=0 && oxfmt -c ../../.oxfmtrc.json --check && cspell lint --no-progress \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,json,html,hbs,handlebars}\"",
        "lint:fix": "oxlint -c ../../.oxlintrc.json --fix && oxfmt -c ../../.oxfmtrc.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "npm run build",
        "test": "npm run test:normal && npm run test:heavy",
        "test:normal": "vitest run --project normal",
        "test:heavy": "vitest run --project heavy",
        "test:ci": "npm run test:coverage",
        "test:coverage": "vitest run --no-file-parallelism --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text-summary"
    },
    "dependencies": {
        "chalk": "^5.4.1",
        "figlet": "^1.8.1",
        "inquirer": "^13.3.2"
    },
    "devDependencies": {
        "@types/figlet": "^1.7.0",
        "@types/node": "^24.0.0",
        "@typescript/typescript6": "^6.0.2",
        "jest-diff": "^30.4.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}