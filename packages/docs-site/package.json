{
    "name": "zibri-docs-site",
    "private": true,
    "version": "1.0.0",
    "main": "./dist/bundle.js",
    "description": "The documentation site of Zibri, built from the pages in packages/zibri/docs.",
    "scripts": {
        "start": "webpack --watch",
        "build": "webpack",
        "export": "node --enable-source-maps dist/bundle.js export",
        "preview": "npm run build && npm run export && node scripts/preview.mjs",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=\"^(?!.*\\.browser\\.test\\.ts$).*\"",
        "test:browser": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=\"\\.browser\\.test\\.ts$\"",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "author": "Tim Fabian",
    "license": "MIT",
    "dependencies": {
        "@fastify/busboy": "^3.2.3",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/sdk-trace-node": "^2.11.0",
        "@prometheus-io/client": "^0.16.1",
        "jose": "^6.2.12",
        "nodemailer": "^10.1.0",
        "otpauth": "^9.5.1",
        "re2": "^1.27.0",
        "saxes": "^6.0.0",
        "systeminformation": "^5.33.15",
        "zibri": "*",
        "zibri-testing": "*"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/node": "^24.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.3",
        "eslint-config-service-soft": "^2.1.6",
        "handlebars-loader": "^1.7.3",
        "jest": "^30.4.2",
        "mini-css-extract-plugin": "^2.10.0",
        "playwright": "^1.61.1",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "shiki": "^4.6.0",
        "source-map-loader": "^5.0.0",
        "tailwindcss": "^4.3.5",
        "ts-jest": "^29.4.11",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.2",
        "webpack": "^5.105.3",
        "webpack-cli": "^6.0.1",
        "zibri-mdx": "*",
        "zibri-tsx-compiler": "*"
    }
}