{
    "name": "zibri-mdx",
    "publishConfig": {
        "access": "public"
    },
    "version": "3.0.1",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/mdx"
    },
    "files": [
        "./dist",
        "./README.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "zibri",
        "mdx",
        "markdown"
    ],
    "author": "Tim Fabian",
    "description": "Builds the markdown and mdx page templates of Zibri applications, and renders markdown at runtime with the same components.",
    "scripts": {
        "build": "npm run build:clean && tsc -p tsconfig.build.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-frontmatter": "^2.0.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-mdx": "^3.0.0",
        "micromark-extension-frontmatter": "^2.0.0",
        "micromark-extension-gfm": "^3.0.0",
        "micromark-extension-mdxjs": "^3.0.0",
        "shiki": "^4.6.0",
        "yaml": "^2.9.1"
    },
    "peerDependencies": {
        "zibri-tsx": "^3.0.1"
    },
    "devDependencies": {
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.0.0",
        "eslint": "^9.36.0",
        "eslint-config-service-soft": "^2.1.6",
        "typescript": "^5.9.2"
    }
}