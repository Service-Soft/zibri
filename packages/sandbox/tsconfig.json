{
    "compilerOptions": {
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "jsx": "react-jsx",
        // Email templates still render through preact and opt back in with a per file
        // `@jsxImportSource preact` pragma.
        "jsxImportSource": "zibri-tsx",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022"
    },
    "include": ["src"]
}