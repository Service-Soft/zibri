{
    "name": "zibri-testing",
    "version": "3.0.0",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/testing"
    },
    "files": [
        "./dist",
        "./README.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "zibri",
        "testing",
        "test-harness"
    ],
    "author": "Tim Fabian",
    "description": "Test harness for Zibri applications: an in process data source, and a real server a test can start.",
    "scripts": {
        "build": "npm run build:clean && tsc -p tsconfig.build.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@peculiar/x509": "^2.1.0",
        "@testcontainers/postgresql": "^12.0.0",
        "ldapts": "^9.2.0",
        "testcontainers": "^12.0.0",
        "xml-crypto": "^6.3.3",
        "xml-encryption": "^3.1.0",
        "zibri": "^3.0.0"
    },
    "peerDependenciesMeta": {
        "@peculiar/x509": {
            "optional": true
        },
        "@testcontainers/postgresql": {
            "optional": true
        },
        "ldapts": {
            "optional": true
        },
        "testcontainers": {
            "optional": true
        },
        "xml-crypto": {
            "optional": true
        },
        "xml-encryption": {
            "optional": true
        }
    },
    "devDependencies": {
        "@peculiar/x509": "^2.1.0",
        "@testcontainers/postgresql": "^12.0.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.36.0",
        "eslint-config-service-soft": "^2.1.6",
        "ldapts": "^9.2.0",
        "testcontainers": "^12.0.0",
        "typescript": "^5.9.2",
        "xml-crypto": "^6.3.3",
        "xml-encryption": "^3.1.0"
    }
}