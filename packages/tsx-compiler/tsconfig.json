{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "importHelpers": false,
        "isolatedModules": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "outDir": "dist",
        // The tests compile and render against the sources of zibri-tsx, as jest.config.mjs maps them, so a template
        // renders with the one runtime it was compiled against. The build resolves the published package instead
        "paths": {
            "zibri-tsx": ["../tsx/src/index.ts"],
            "zibri-tsx/*": ["../tsx/src/*"]
        },
        "resolveJsonModule": true,
        // over both packages, as the sources of zibri-tsx are part of what the tests are checked with
        "rootDir": "..",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node"],
        "useDefineForClassFields": true,
        "useUnknownInCatchVariables": true
    },
    // what tests write there, such as projects whose type errors a test builds on purpose
    "exclude": ["src/__testing__/file-output"],
    "include": ["src", "jest.config.mjs", "jest.typescript-6.config.mjs"]
}