{
    "name": "zibri-tsx",
    "version": "3.0.0",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./compiler": {
            "types": "./dist/compiler.d.ts",
            "default": "./dist/compiler.js"
        },
        "./vite": {
            "types": "./dist/vite/index.d.ts",
            "default": "./dist/vite/index.js"
        },
        "./email": {
            "types": "./dist/email/index.d.ts",
            "default": "./dist/email/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "default": "./dist/jsx-runtime.js"
        },
        "./package.json": "./package.json"
    },
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/tsx"
    },
    "files": [
        "./dist",
        "./README.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "zibri",
        "tsx",
        "compiler"
    ],
    "author": "Tim Fabian",
    "description": "Hand-written TSX compiler for Zibri page templates.",
    "scripts": {
        "build": "npm run build:clean && tsc -p tsconfig.build.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint -c ../../.oxlintrc.json --max-warnings=0 && oxfmt -c ../../.oxfmtrc.json --check && cspell lint --no-progress \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,json,html,hbs,handlebars}\"",
        "lint:fix": "oxlint -c ../../.oxlintrc.json --fix && oxfmt -c ../../.oxfmtrc.json",
        "prepublishOnly": "npm run build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "@typescript/typescript6": "^6.0.2"
    },
    "peerDependenciesMeta": {
        "@typescript/typescript6": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@typescript/typescript6": "^6.0.2",
        "mjml": "^5.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}