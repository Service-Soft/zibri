{
    "name": "zibri-tsx",
    "publishConfig": {
        "access": "public"
    },
    "version": "3.0.1",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./internal": {
            "types": "./dist/internal.d.ts",
            "default": "./dist/internal.js"
        },
        "./compiler": {
            "types": "./forward/compiler.d.ts",
            "default": "./forward/compiler.js"
        },
        "./webpack": {
            "types": "./forward/webpack.d.ts",
            "default": "./forward/webpack.js"
        },
        "./jest": {
            "types": "./forward/jest.d.ts",
            "default": "./forward/jest.js"
        },
        "./email": {
            "types": "./dist/email/index.d.ts",
            "default": "./dist/email/index.js"
        },
        "./jsx-runtime": {
            "types": "./dist/jsx-runtime.d.ts",
            "default": "./dist/jsx-runtime.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "internal": [
                "./dist/internal.d.ts"
            ],
            "compiler": [
                "./forward/compiler.d.ts"
            ],
            "webpack": [
                "./forward/webpack.d.ts"
            ],
            "jest": [
                "./forward/jest.d.ts"
            ],
            "email": [
                "./dist/email/index.d.ts"
            ],
            "jsx-runtime": [
                "./dist/jsx-runtime.d.ts"
            ]
        }
    },
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/tsx"
    },
    "files": [
        "./dist",
        "./forward",
        "./README.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "keywords": [
        "zibri",
        "tsx",
        "compiler"
    ],
    "author": "Tim Fabian",
    "description": "The TSX runtime of Zibri page and email templates, which zibri-tsx-compiler compiles them for.",
    "scripts": {
        "build": "npm run build:clean && tsc -p tsconfig.build.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "prepublishOnly": "npm run build",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=\"^(?!.*\\.browser\\.test\\.ts$).*\"",
        "test:browser": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=\"\\.browser\\.test\\.ts$\"",
        "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --testPathPatterns=\"^(?!.*\\.browser\\.test\\.ts$).*\""
    },
    "peerDependencies": {
        "cheerio": "^1.2.0"
    },
    "peerDependenciesMeta": {
        "cheerio": {
            "optional": true
        }
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@types/node": "^24.0.0",
        "cheerio": "^1.2.0",
        "eslint": "^9.36.0",
        "eslint-config-service-soft": "^2.1.6",
        "jest": "^30.4.2",
        "mjml": "^5.4.0",
        "playwright": "^1.61.1",
        "ts-jest": "^29.4.11",
        "typescript": "^5.9.2",
        "zibri-tsx-compiler": "^3.0.1"
    }
}