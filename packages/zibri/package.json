{
    "name": "zibri",
    "publishConfig": {
        "access": "public"
    },
    "version": "3.0.1",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/zibri"
    },
    "exports": {
        ".": {
            "types": "./dist/cjs/index.d.ts",
            "default": "./dist/cjs/index.js"
        },
        "./webpack": {
            "types": "./dist/cjs/webpack/index.d.ts",
            "default": "./dist/cjs/webpack/index.js"
        },
        "./internal": {
            "types": "./dist/cjs/internal.d.ts",
            "default": "./dist/cjs/internal.js"
        },
        "./tsconfig.application.json": "./tsconfig.application.json",
        "./package.json": "./package.json"
    },
    "files": [
        "./tsconfig.application.json",
        "./translations",
        "./src",
        "!src/**/__testing__/**",
        "!src/**/test/**",
        "!src/**/*.test.ts",
        "!src/**/*.cases.ts",
        "!src/**/*.instance-options.ts",
        "!src/**/*.test.worker.*",
        "!src/**/*.json",
        "!src/jest.*",
        "./dist",
        "./README.md",
        "../../CONTRIBUTING.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "npm run test:normal && npm run test:heavy && npm run test:cluster && npm run test:benchmark",
        "test:ci": "npm run test:coverage && npm run test:cluster",
        "test:heavy": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathPatterns=\"(multithreading\\.service\\.performance\\.test\\.ts|pay-pal\\.payment-provider\\.test\\.ts|base-keycloak\\.authenticator\\.test\\.ts|\\.heavy\\.test\\.ts)\"",
        "test:normal": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --testPathPatterns=\"^(?!.*(multithreading\\.service\\.performance\\.test\\.ts|pay-pal\\.payment-provider\\.test\\.ts|base-keycloak\\.authenticator\\.test\\.ts|\\.heavy\\.test\\.ts|\\.cluster\\.test\\.ts|\\.benchmark\\.test\\.ts)).*\"",
        "test:cluster": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathPatterns=\"\\.cluster\\.test\\.ts$\"",
        "test:benchmark": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testPathPatterns=\"\\.benchmark\\.test\\.ts$\"",
        "test:benchmark:compare": "node scripts/compare-benchmarks.mjs test:benchmark",
        "test:coverage": "npm run test:coverage:normal && npm run test:coverage:heavy && npm run test:coverage:merge",
        "test:coverage:normal": "npm run test:normal -- --coverage --coverageDirectory=__testing__/coverage/raw/normal --coverageReporters=json",
        "test:coverage:heavy": "npm run test:heavy -- --coverage --coverageDirectory=__testing__/coverage/raw/heavy --coverageReporters=json",
        "test:coverage:merge": "mkdir -p src/__testing__/coverage/merge-input && cp src/__testing__/coverage/raw/normal/coverage-final.json src/__testing__/coverage/merge-input/normal.json && cp src/__testing__/coverage/raw/heavy/coverage-final.json src/__testing__/coverage/merge-input/heavy.json && nyc merge src/__testing__/coverage/merge-input src/__testing__/coverage/coverage-final.json && nyc report --temp-dir=src/__testing__/coverage --report-dir=src/__testing__/coverage/report --reporter=lcov --reporter=text-summary --reporter=json-summary",
        "start": "npm run watch:cjs",
        "watch:cjs": "tsc -p tsconfig.cjs.json --watch",
        "build:prod": "npm run build && typedoc",
        "build:cjs": "tsc -p tsconfig.cjs.code.json && tsc -p tsconfig.cjs.declarations.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build:translations": "node scripts/extract-translations.mjs",
        "build": "npm run build:clean && npm run build:cjs && npm run build:translations",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --max-warnings=0 --fix",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "Zibri",
        "Backend",
        "Framework"
    ],
    "author": "Tim Fabian",
    "license": "MIT",
    "description": "TS Backend Framework",
    "peerDependencies": {
        "@fastify/busboy": "^3.2.0",
        "@node-saml/node-saml": "^5.1.0",
