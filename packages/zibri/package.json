{
    "name": "zibri",
    "version": "3.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "url": "https://github.com/Service-Soft/zibri",
        "directory": "packages/zibri"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "./src",
        "!src/**/__testing__/**",
        "!src/**/test/**",
        "!src/**/*.test.ts",
        "!src/**/*.cases.ts",
        "!src/**/*.test.worker.*",
        "./dist",
        "./README.md",
        "../../CONTRIBUTING.md",
        "./LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "npm run test:normal && npm run test:heavy && npm run test:evaluation && npm run test:cluster && npm run test:benchmark",
        "test:ci": "npm run test:coverage",
        "test:heavy": "vitest run --project heavy",
        "test:normal": "vitest run --project normal",
        "test:evaluation": "vitest run --project evaluation",
        "test:cluster": "vitest run --project cluster",
        "test:benchmark": "vitest run --project benchmark",
        "test:coverage": "npm run test:coverage:normal && npm run test:coverage:heavy && npm run test:coverage:merge",
        "test:coverage:normal": "npm run test:normal -- --coverage.enabled --coverage.reportsDirectory=src/__testing__/coverage/raw/normal --coverage.reporter=json",
        "test:coverage:heavy": "npm run test:heavy -- --coverage.enabled --coverage.reportsDirectory=src/__testing__/coverage/raw/heavy --coverage.reporter=json",
        "test:coverage:merge": "mkdir -p src/__testing__/coverage/merge-input && cp src/__testing__/coverage/raw/normal/coverage-final.json src/__testing__/coverage/merge-input/normal.json && cp src/__testing__/coverage/raw/heavy/coverage-final.json src/__testing__/coverage/merge-input/heavy.json && nyc merge src/__testing__/coverage/merge-input src/__testing__/coverage/coverage-final.json && nyc report --temp-dir=src/__testing__/coverage --report-dir=src/__testing__/coverage/report --reporter=lcov --reporter=text-summary --reporter=json-summary",
        "start": "npm run watch",
        "watch": "tsc -p tsconfig.build.json --watch",
        "build:prod": "npm run build && typedoc",
        "build:code": "tsc -p tsconfig.build.code.json && tsc -p tsconfig.build.declarations.json",
        "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run build:clean && npm run build:code",
        "lint": "oxlint -c ../../.oxlintrc.json --max-warnings=0 && oxfmt -c ../../.oxfmtrc.json --check && cspell lint --no-progress \"**/*.{ts,tsx,mts,cts,js,mjs,cjs,json,html,hbs,handlebars}\"",
        "lint:fix": "oxlint -c ../../.oxlintrc.json --fix && oxfmt -c ../../.oxfmtrc.json",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "keywords": [
        "Zibri",
        "Backend",
        "Framework"
    ],
    "author": "Tim Fabian",
    "license": "MIT",
    "description": "TS Backend Framework",
    "peerDependencies": {
        "@fastify/busboy": "^3.2.0",
        "@node-saml/node-saml": "^5.1.0",
        "@opentelemetry/api": "^1.9.1",
