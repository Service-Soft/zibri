{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "forceConsistentCasingInFileNames": true,
        "inlineSourceMap": false,
        "inlineSources": false,
        "isolatedModules": true,
        "module": "nodenext",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "rewriteRelativeImportExtensions": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022"
    },
    "files": [
        "src/index.ts",
        "src/multithreading/services/worker/thread-job.worker.ts",
        "src/utilities/typescript-loader/decorate.function.ts",
        "src/utilities/typescript-loader/decorate-metadata.function.ts",
        "src/utilities/typescript-loader/decorate-param.function.ts"
    ]
}