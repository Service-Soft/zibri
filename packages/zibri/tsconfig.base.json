{
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDecoratorMetadata": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "forceConsistentCasingInFileNames": true,
        "inlineSourceMap": false,
        "inlineSources": false,
        "isolatedModules": true,
        "module": "nodenext",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022"
    },
    "files": [
        "src/index.ts",
        "src/internal.ts",
        "src/webpack/index.ts",
        "src/multithreading/services/worker/thread-job.worker.ts",
        "src/plugin/analytics/index.ts",
        "src/plugin/approval/index.ts",
        "src/plugin/bank/index.ts",
        "src/plugin/bookkeeping/index.ts",
        "src/plugin/invoicing/index.ts",
        "src/plugin/mailing-list/index.ts",
        "src/plugin/mcp/index.ts",
        "src/plugin/payment/index.ts",
        "src/plugin/projects/index.ts"
    ]
}