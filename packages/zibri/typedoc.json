{
    "entryPointStrategy": "expand",
    "entryPoints": ["src"],
    "exclude": [
        "src/index.ts",
        "src/vitest.setup.ts",
        "src/vitest.global-setup.ts",
        "src/**/*.test.ts",
        "src/__testing__/**"
    ],
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeReferences": true,
    "out": "docs/generated",
    "projectDocuments": [
        "./docs/getting-started.md",
        "./docs/architecture.md",
        "./docs/creating-endpoints.md",
        "./docs/!(getting-started|architecture|creating-endpoints).md"
    ],
    "readme": "none",
    "tsconfig": "tsconfig.base.json"
}