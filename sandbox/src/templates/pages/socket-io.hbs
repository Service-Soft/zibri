<div style="height: 100%; width: 100%; display: flex; color: whitesmoke; padding-left: 40px; padding-right: 40px; flex-direction: column;">
    <h1 style="margin-top: 20px; margin-bottom: 20px;">Socket Test</h1>

    <div style="flex: 1; display: flex; max-height: 85vh; background-color: gray; border-radius: 15px; margin-bottom: 40px; box-shadow: 0 0 8px 4px rgba(0, 0, 0, 0.15);">
        <div style="background-color: #1a1a26; width: 40%; padding: 15px; border-radius: 15px 0px 0px 15px;">
            <h2>Chats</h2>
            <hr>
        </div>
        <div style="display: flex; flex-direction: column; width: 100%; padding: 15px; padding-left: 0px;">
            <ul style="flex: 1; overflow: scroll;" id="messages"></ul>
            <form id="form" style="background-color: #1a1a26; margin: -15px; padding: 15px; border-radius: 0px 0px 15px 0px;">
                <div style="display: flex; justify-content: center; align-items: center; gap: 20px;">
                    <textarea id="input" autocomplete="off" style="flex: 1;"></textarea>
                    <button type="submit" style="min-width: 150px; height: 100%;">Send</button>
                </div>
            </form>
        </div>
    </div>

    <dialog id="dialog">
        <h2 id="error-dialog-title"></h2>
        <div style="margin-bottom: 10px;" id="error-paragraphs"></div>
        <button onclick="closeDialog()">Close</button>
    </dialog>
</div>

<style>
    li {
        padding: 15px;
        border-radius: 15px;
        background-color: #0e456f;
        width: fit-content;
        max-width: 50%;
        margin-bottom: 10px;
        margin-right: 10px;
        word-break: break-all;
    }
    .own-message {
        background-color: #00b4d8;
        margin-left: auto;
    }
</style>

<script src="/assets/socket.io.js"></script>
<script>
    const socket = io({
        auth: {
            offset: 0
        }
    });

    const form = document.getElementById('form');
    const input = document.getElementById('input');
    const messages = document.getElementById('messages');
    const dialog = document.getElementById('dialog');
    const errorParagraphs = document.getElementById('error-paragraphs');
    const errorDialogTitle = document.getElementById('error-dialog-title');
    
    const closeDialog = () => {
        errorParagraphs.replaceChildren();
        dialog.close();
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (input.value) {
            const response = await socket.timeout(3000)
                .emitWithAck(
                    'chat message',
                    { 
                        headers:  { Authorization : 'Bearer 12376892311' },
                        body: { 
                            message: input.value
                        }
                    }
                );

            if (!response.ok) {
                errorDialogTitle.textContent = `Error: ${response.error.status}`;
                for (const p of response.error.paragraphs) {
                    const item = document.createElement('p');
                    item.textContent = p;
                    errorParagraphs.appendChild(item);
                }
                dialog.showModal();
                console.error(response.error);
                return;
            }
            else {
                input.value = '';
            }
        }
    });

    socket.on('chat message', (msg, ack) => {
        const item = document.createElement('li');
        item.innerHTML = `
            <div>${msg.data.message}</div>
            <div>senderConnectionId: ${msg.senderConnectionId}</div>
            <div>senderUserId: ${msg.senderUserId}</div>
        `;
        if (msg.senderConnectionId === socket.id) {
            item.classList.add('own-message');
        }
        messages.appendChild(item);
        window.scrollTo(0, document.body.scrollHeight);
        if (typeof ack === 'function') {
            ack();
        }
    });

    socket.onAny((ev, msg, ack) => {
        console.debug('got a new message:', ev, msg, '\n');
        if (msg.seq > socket.auth.offset) {
            socket.auth.offset = msg.seq;
            console.debug('set offset to', msg.seq);
        }
    });
</script>